{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Dashboard desktop permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "codex://*" }]
    }
  ]
}
