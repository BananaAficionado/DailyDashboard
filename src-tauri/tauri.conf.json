{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Dashboard",
  "mainBinaryName": "V0.4.5_Daily-Dashboard",
  "version": "0.4.5",
  "identifier": "com.bananaaficionado.daily-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Daily Dashboard",
        "width": 1280,
        "height": 400,
        "minWidth": 960,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": null,
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
