{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily Dashboard",
  "mainBinaryName": "V0.5.13_Daily-Dashboard",
  "version": "0.5.13",
  "identifier": "com.bananaaficionado.daily-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Daily Dashboard",
        "width": 1280,
        "height": 400,
        "minWidth": 960,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.googleapis.com https://graph.microsoft.com https://api.spotify.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.rainviewer.com https://overpass-api.de https://tile.openstreetmap.org https://services.arcgisonline.com https://tilecache.rainviewer.com"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.googleapis.com https://graph.microsoft.com https://api.spotify.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.rainviewer.com https://overpass-api.de https://tile.openstreetmap.org https://services.arcgisonline.com https://tilecache.rainviewer.com http://127.0.0.1:1420 ws://127.0.0.1:1420 http://localhost:1420 ws://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": null,
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {}
}
